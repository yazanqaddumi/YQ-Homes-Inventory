const $=q=>document.querySelector(q), esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const cleanName=s=>String(s||'').replace(/(?:\s*\((?:UNT|FT|PCS|EA|UNIT|ROLL|BOX|PC|JUG)\))+\s*$/gi,'').trim();

async function refresh(silent=false){if(!client||!user||polling||unsaved)return;polling=true;try{let {data,error}=await client.from('stock_items').select('id,data').eq('user_id',user.id).order('id');if(error)throw error;const settingsRow=(data||[]).find(x=>x.id===SETTINGS_ROW_ID);if(settingsRow?.data){const w=settingsRow.data;warehouse={categories:w.categories||null,metrics:Array.isArray(w.metrics)?w.metrics:[...DEFAULT_METRICS],theme:w.theme||'signal',defaultView:w.defaultView||'folders',headline:w.headline||'Stock It Up Job It Right',description:w.description||'A better way to keep materials ready, track supplies and prepare for every job.'}}items=(data||[]).filter(x=>x.id!==SETTINGS_ROW_ID).map(x=>normalize({...x.data,id:x.id}));if(!window.__viewInitialized){browseMode=warehouse.defaultView;window.__viewInitialized=true}themeApply();render();setStatus('☁ Synced · '+user.email+' · '+new Date().toLocaleTimeString([],{hour:'numeric',minute:'2-digit'}))}catch(e){setStatus('Sync error: '+e.message,true);if(!silent)alert('Cannot load inventory: '+e.message)}finally{polling=false}}

// Search is computed from the live items array on every render. No separate index to get stale.
function searchTerms(value){
 const cleaned=String(value||'').normalize('NFKD').replace(/[\u0300-\u036f]/g,'').toLowerCase()
  .replace(/[\u2018\u2019\u201c\u201d\u2032\u2033]/g,' ')
  .replace(/[^\p{L}\p{N}.]+/gu,' ')
  .replace(/\.(?!\d)|(?<!\d)\./g,' ');
 return [...new Set(cleaned.match(/[\p{L}\p{N}]+(?:\.\d+)?/gu)||[])];
}
function nearMatch(query,word){
 if(word.includes(query))return true;
 // A single typo is allowed for longer words, without broad fuzzy matching of short sizes.
 if(query.length<5||word.length<5||Math.abs(query.length-word.length)>1)return false;
 let i=0,j=0,changes=0;
 while(i<query.length&&j<word.length){
  if(query[i]===word[j]){i++;j++;continue}
  if(++changes>1)return false;
  if(query.length>word.length)i++;
  else if(query.length<word.length)j++;
  else{i++;j++}
 }
 return changes+Math.max(query.length-i,word.length-j)<=1;
}
function searchMatch(item,terms){
 if(!terms.length)return true;
 const fields=[item.name,item.category,item.subcategory,item.location,item.id,item.supplier,item.notes,item.buyFor];
 const tokens=fields.flatMap(searchTerms);
 return terms.every(q=>tokens.some(w=>nearMatch(q,w)));
}
function searchRank(item,terms){
 if(!terms.length)return 0;
 const name=searchTerms(item.name),meta=searchTerms([item.category,item.subcategory,item.location].join(' '));
 return terms.reduce((score,q)=>score+(name.some(w=>w===q)?8:name.some(w=>w.startsWith(q))?5:name.some(w=>nearMatch(q,w))?3:meta.some(w=>nearMatch(q,w))?1:0),0);
}
function highlightMatches(value,terms){
 const str=String(value??'');if(!terms.length)return esc(str);
 const wordPattern=/[\p{L}\p{N}]+(?:[.,]\d+)?/gu;
 let result='',last=0,match;
 while((match=wordPattern.exec(str))){
  const word=match[0],normalized=searchTerms(word)[0]||'';
  result+=esc(str.slice(last,match.index));
  result+=terms.some(q=>nearMatch(q,normalized))?'<mark class="search-hit">'+esc(word)+'</mark>':esc(word);
  last=wordPattern.lastIndex;
 }
 return result+esc(str.slice(last));
}

function render(){
 const term=$('#search').value.trim(),terms=searchTerms(term),selected=$('#cat').value,subselected=$('#subcat').value;
 const catMap=mergedCategories(),cats=Object.keys(catMap);
 $('#cat').innerHTML='<option value="">All categories</option>'+cats.map(c=>`<option value="${esc(c)}">${esc(c)}</option>`).join('');$('#cat').value=selected;
 const subs=selected?(catMap[selected]||[]):[...new Set(Object.values(catMap).flat())].sort();
 $('#subcat').innerHTML='<option value="">All subcategories</option>'+subs.map(c=>`<option value="${esc(c)}">${esc(c)}</option>`).join('');$('#subcat').value=subselected;
 
 const qtyTotal=items.reduce((sum,i)=>sum+i.quantity,0),costTotal=items.reduce((sum,i)=>sum+i.quantity*(i.cost||0),0),low=items.filter(i=>i.min>0&&i.quantity<=i.min).length;const costDisplay='$'+costTotal.toLocaleString('en-CA',{minimumFractionDigits:2,maximumFractionDigits:2});const statData={items:[items.length,'Items'],quantity:[qtyTotal.toLocaleString(),'Total quantity (mixed units)'],categories:[cats.length,'Categories'],value:[costDisplay,'Inventory cost value (CAD)'],low:[low,'Low stock items']};$('#dashboardStats').innerHTML=(warehouse.metrics||DEFAULT_METRICS).map(id=>statData[id]?`<div class="stat"><strong>${esc(statData[id][0])}</strong><span>${esc(statData[id][1])}</span></div>`:'').join('');
 for(const state of ['stop','ready','go']){$('#'+state+'Count').textContent=items.filter(i=>stockState(i)===state).length;document.querySelector('.stock-filter.'+state).classList.toggle('active',stockFilter===state)}
 $('#buyCount').textContent=items.filter(i=>i.needBuy).length;$('#buyToggle').classList.toggle('active',buyOnly);$('#buyToggle').setAttribute('aria-pressed',String(buyOnly));
 $('#chips').innerHTML=`<button class="chip ${selected?'':'active'}" onclick="setCat('')">All</button>`+cats.map(c=>`<button class="chip ${selected===c?'active':''}" onclick='setCat(${JSON.stringify(c)})'>${esc(c)}</button>`).join('');
 const atFolders=renderNavigation();const folderMode=browseMode==='folders'&&!term&&!stockFilter&&!buyOnly;const filtered=atFolders?[]:items.filter(i=>(!buyOnly||i.needBuy)&&(!stockFilter||stockState(i)===stockFilter)&&(!folderMode||i.category===browseCat&&(browseSub==='__UNSORTED__'?!i.subcategory:i.subcategory===browseSub))&&(!selected||folderMode||i.category===selected)&&(!subselected||folderMode||i.subcategory===subselected)&&searchMatch(i,terms)).sort((a,b)=>terms.length?searchRank(b,terms)-searchRank(a,terms)||a.name.localeCompare(b.name):a.name.localeCompare(b.name));
 $('#cards').innerHTML=atFolders?'':filtered.length?filtered.map(i=>`<article class="item"><div>${i.photo?`<img class="thumb" loading="lazy" src="${esc(i.photo)}" onerror="this.outerHTML='<div class=&quot;thumb placeholder&quot;>📦</div>'">`:'<div class="thumb placeholder">📦</div>'}</div><div><div class="itemname">${highlightMatches(i.name,terms)}</div><div class="meta">${highlightMatches(i.category,terms)}${i.subcategory?' / '+highlightMatches(i.subcategory,terms):''}${i.location?' • '+highlightMatches(i.location,terms):''}</div>${i.cost>0?`<div class="meta">Cost: $${i.cost.toFixed(2)} CAD / ${esc(i.unit)} · Stock value: $${(i.quantity*i.cost).toFixed(2)}</div>`:''}<div class="item-status ${stockState(i)}"><span class="status-dot"></span>${stockState(i)==='stop'?'STOP · Out of stock':stockState(i)==='ready'?'READY · Reorder soon':'GO · In stock'}</div>${i.needBuy?`<div class="buy-badge"><span class="buy-dot"></span> NEED TO BUY</div>${i.buyFor?`<div class="buy-note">${highlightMatches(i.buyFor,terms)}</div>`:''}`:''}<div class="actionrow"><button class="step" onclick='adjust(${JSON.stringify(i.id)},-1)' aria-label="Decrease quantity">−</button><div class="qty">${i.quantity} <small>${esc(i.unit)}</small></div><button class="step" onclick='adjust(${JSON.stringify(i.id)},1)' aria-label="Increase quantity">+</button><button class="edit" onclick='editItem(${JSON.stringify(i.id)})'>Edit</button></div><div class="picker"><input class="pickbox" type="number" min="1" step="1" inputmode="numeric" id="pick-${esc(i.id)}" value="1" aria-label="Quantity to take"><button class="pickBtn" onclick='addPick(${JSON.stringify(i.id)})'>+ Pick list</button></div></div></article>`).join(''):'<div class="empty">No matching items. Try another category or search.</div>';
 let count=Object.values(pickList).reduce((a,b)=>a+b,0);$('#pickSummary').classList.toggle('active',count>0);$('#pickCount').textContent=`${count} units across ${Object.keys(pickList).length} items`;
}
function setCat(c){$('#cat').value=c;$('#subcat').value='';render()}
function addPick(id){let i=items.find(x=>x.id===id);if(!i)return;let n=Number(document.getElementById('pick-'+id)?.value||1);if(!Number.isInteger(n)||n<1)return alert('Enter a whole-number quantity');if((pickList[id]||0)+n>i.quantity)return alert('Not enough stock available');pickList[id]=(pickList[id]||0)+n;render()}
function openPickList(){const lines=Object.entries(pickList).map(([id,n])=>{let i=items.find(x=>x.id===id);return i?`<div style="display:flex;justify-content:space-between;gap:10px;border-bottom:1px solid #344257;padding:11px 0"><div><strong>${esc(i.name)}</strong><div class="meta">${n} ${esc(i.unit)} · ${esc(i.location||'No bin assigned')}</div></div><button onclick='removePick(${JSON.stringify(id)})'>Remove</button></div>`:''}).join('');$('#pickLines').innerHTML=lines||'<p>No supplies selected.</p>';$('#pickDialog').showModal()}

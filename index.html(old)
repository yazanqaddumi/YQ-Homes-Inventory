async function confirmPickList(){if(!user)return showAccount();const choices=Object.entries(pickList);if(!choices.length)return;const btn=$('#confirmPick');btn.disabled=true;let processed=[];try{for(const [id,n] of choices){const {data,error}=await client.rpc('adjust_stock',{p_id:id,p_delta:-n});if(error)throw Error(id+': '+error.message);processed.push(id);delete pickList[id]}$('#pickDialog').close();await refresh();alert('Updated '+processed.length+' items. Stock quantities saved to Supabase.')}catch(e){$('#pickDialog').close();await refresh();alert('Some items may not have been updated. '+processed.length+' completed. Check your stock before trying again. '+e.message)}finally{btn.disabled=false;render()}}
async function saveOne(i){if(!user)throw Error('Sign in first');const {error}=await client.from('stock_items').upsert({user_id:user.id,id:i.id,data:i},{onConflict:'user_id,id'});if(error)throw error}
async function adjust(id,by){if(!user)return showAccount();const i=items.find(x=>x.id===id);if(!i)return;let old=i.quantity;i.quantity=Math.max(0,old+by);render();unsaved=true;try{const {data,error}=await client.rpc('adjust_stock',{p_id:id,p_delta:by});if(error)throw error;if(data&&data.quantity!==undefined)i.quantity=Number(data.quantity);setStatus('☁ Saved · '+new Date().toLocaleTimeString())}catch(e){i.quantity=old;alert('Quantity not saved: '+e.message)}finally{unsaved=false;render()}}
function editItem(id){if(!user)return showAccount();editing=id||null;const i=items.find(x=>x.id===id)||{name:'',quantity:0,category:'',subcategory:'',unit:'UNT',location:'',notes:'',min:0,cost:0,supplier:''};$('#dialogTitle').textContent=editing?'Edit item':'Add new item';$('#iname').value=i.name;$('#iquantity').value=i.quantity;const catList=Object.keys(mergedCategories());$('#icategory').innerHTML=htmlOptions(catList,i.category,'Select category');$('#icategory').value=i.category||'';updateEditorSubs(i.subcategory||'');$('#iunit').value=i.unit||'UNT';$('#ilocation').value=i.location;$('#inotes').value=i.notes;$('#imin').value=i.min;$('#ineedbuy').checked=!!i.needBuy;$('#ibuyfor').value=i.buyFor||'';$('#icost').value=i.cost||0;$('#isupplier').value=i.supplier||'';$('#iphoto').value='';$('#del').classList.toggle('hidden',!editing);$('#editor').showModal()}
function scaledPhoto(file){return new Promise((resolve,reject)=>{const img=new Image(),reader=new FileReader();reader.onload=()=>{img.onload=()=>{const scale=Math.min(1,650/Math.max(img.width,img.height));const c=document.createElement('canvas');c.width=Math.max(1,Math.round(img.width*scale));c.height=Math.max(1,Math.round(img.height*scale));c.getContext('2d').drawImage(img,0,0,c.width,c.height);resolve(c.toDataURL('image/jpeg',.58))};img.onerror=()=>reject(Error('Image cannot be opened'));img.src=reader.result};reader.onerror=()=>reject(Error('Image cannot be read'));reader.readAsDataURL(file)})}
async function saveItem(ev){ev.preventDefault();if(!user)return;const btn=$('#itemForm button[type=submit]');btn.disabled=true;const old=items.find(x=>x.id===editing);let i={...old,id:editing||crypto.randomUUID(),name:cleanName($('#iname').value),quantity:Math.max(0,Number($('#iquantity').value)||0),category:$('#icategory').value||'Uncategorized',subcategory:$('#isubcategory').value,unit:$('#iunit').value,location:$('#ilocation').value.trim(),notes:$('#inotes').value.trim(),min:Math.max(0,Number($('#imin').value)||0),needBuy:$('#ineedbuy').checked,buyFor:$('#ibuyfor').value.trim(),cost:Math.max(0,Number($('#icost').value)||0),supplier:$('#isupplier').value.trim(),photo:old?.photo||''};try{if($('#iphoto').files[0])i.photo=await scaledPhoto($('#iphoto').files[0]);await saveOne(i);$('#editor').close();await refresh()}catch(e){alert('Save failed: '+e.message)}finally{btn.disabled=false}}
async function deleteItem(){if(!editing||!user||!confirm('Delete this inventory item?'))return;const {error}=await client.from('stock_items').delete().eq('user_id',user.id).eq('id',editing);if(error)return alert(error.message);$('#editor').close();await refresh()}
function download(name,contents,type){const a=document.createElement('a'),url=URL.createObjectURL(new Blob([contents],{type}));a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),2000)}
function exportBackup(){download('YQ-Homes-Inventory-Backup-'+new Date().toISOString().slice(0,10)+'.json',JSON.stringify({app:'YQ Homes Inc. Stock',version:2,items},null,2),'application/json')}
function csvCell(s){return '"'+String(s??'').replaceAll('"','""')+'"'}
function exportCSV(){const keys=['id','name','quantity','unit','category','subcategory','location','notes','min','needBuy','buyFor','cost','supplier','photo'];download('YQ-Homes-Inventory.csv',keys.join(',')+'\r\n'+items.map(i=>keys.map(k=>csvCell(i[k])).join(',')).join('\r\n'),'text/csv')}
function parseCSV(t){let records=[],record=[],field='',quoted=false;for(let j=0;j<t.length;j++){let c=t[j];if(quoted){if(c==='"'&&t[j+1]==='"'){field+='"';j++}else if(c==='"')quoted=false;else field+=c}else if(c==='"')quoted=true;else if(c===','){record.push(field);field=''}else if(c==='\n'){record.push(field.replace(/\r$/,''));records.push(record);record=[];field=''}else field+=c}if(field||record.length){record.push(field);records.push(record)}const hdr=records.shift()?.map(x=>x.replace(/^\ufeff/,''))||[];return records.filter(r=>r.some(Boolean)).map(r=>Object.fromEntries(hdr.map((h,j)=>[h,r[j]||''])))}
async function importFile(ev){const f=ev.target.files[0];if(!f)return;if(!user){alert('Sign in first');return}try{let imported=f.name.toLowerCase().endsWith('.json')?JSON.parse(await f.text()):parseCSV(await f.text());if(!Array.isArray(imported))imported=imported.items;if(!Array.isArray(imported)||!imported.length)throw Error('No items found');const normalized=imported.map(normalize);if(!confirm(`Import ${normalized.length} items to your shared cloud inventory? Existing items with the same ID will be updated.`))return;let done=0;for(let k=0;k<normalized.length;k+=10){let batch=normalized.slice(k,k+10).map(i=>({user_id:user.id,id:i.id,data:i}));let {error}=await client.from('stock_items').upsert(batch,{onConflict:'user_id,id'});if(error)throw error;done+=batch.length;setStatus('Uploading '+done+'/'+normalized.length+' items…')}await refresh();alert(`Imported ${done} items into your cloud inventory.`)}catch(e){alert('Import failed: '+e.message)}finally{ev.target.value=''}}
function showAccount(){const el=$('#accountContents');if(user){el.innerHTML=`<p>Signed in: <b>${esc(user.email)}</b></p><p>Site is connected to Supabase. Stock updates are saved online. Both devices must use the same email account.</p><button onclick="signOut()">Sign out</button>`}else{el.innerHTML=`<p class="help">Your cloud connection is already configured. Sign in with your existing inventory account. Never enter a secret/service_role key.</p><label>Supabase project URL</label><input id="surl" placeholder="https://xxxxx.supabase.co" value="${esc(settings.url||'')}"><label>Publishable key (sb_publishable_... or legacy anon)</label><input id="skey" placeholder="sb_publishable_..." value="${esc(settings.key||'')}"><button class="primary" onclick="connectSettings()">Save connection</button><hr style="border-color:#334155"><label>Email</label><input id="semail" type="email" autocomplete="username" placeholder="you@example.com"><label>Password</label><input id="spass" type="password" autocomplete="current-password" placeholder="At least 6 characters"><div class="buttons"><button class="primary" onclick="authAction('signin')">Sign in</button><button onclick="authAction('signup')">Create account</button></div><div class="help" id="authmsg">Use the same email/password on both devices. You may need to confirm your email first.</div>`}$('#account').showModal()}
function connectSettings(){const url=$('#surl').value.trim(),key=$('#skey').value.trim();if(!url||!key)return alert('Enter both values');settings={url,key};storeSettings();client=null;user=null;if(initClient()){setStatus('Connection settings saved. Sign in below.');alert('Saved. Now create an account or sign in.')}else alert('Check the Supabase URL and key.')}
async function authAction(mode){if(!client){alert('Save the Supabase connection first');return}let email=$('#semail').value.trim(),password=$('#spass').value;if(!email||!password)return alert('Enter email and password');let {data,error}=mode==='signup'?await client.auth.signUp({email,password}):await client.auth.signInWithPassword({email,password});if(error)return $('#authmsg').textContent=error.message;if(!data.session){$('#authmsg').textContent='Account created. Check your email for the confirmation link, then sign in.';return}user=data.user;$('#account').close();setStatus('Connected. Loading…');await refresh()}
async function signOut(){await client.auth.signOut();user=null;items=[];render();$('#account').close();setStatus('Signed out. Sign in to sync.')}
// Close pop-up dialogs when tapping/clicking their shaded backdrop.
// Only outside taps close; interactions inside the dialog stay unchanged.
for(const dlg of document.querySelectorAll('dialog')){
  dlg.addEventListener('click', event => {
    if(event.target !== dlg || !dlg.open) return;
    const rect = dlg.getBoundingClientRect();
    const outside = event.clientX < rect.left || event.clientX > rect.right ||
                    event.clientY < rect.top || event.clientY > rect.bottom;
    if(outside) dlg.close();
  });
}
themeApply();setInterval(()=>{if(user&&!document.hidden)refresh(true)},10000);document.addEventListener('visibilitychange',()=>{if(!document.hidden&&user)refresh(true)});render();boot();

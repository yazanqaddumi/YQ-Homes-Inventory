let settings={...DEFAULT_CONNECTION,...JSON.parse(localStorage.getItem(CONFIG_KEY)||'{}')},client=null,user=null,items=[],editing=null,loading=false,polling=false,unsaved=false;let pickList={};const DEFAULT_CATS={'HVAC':['Gas piping & fittings','Gas valves & regulators','Furnace parts','AC & refrigeration','Venting','Ductwork','Controls & thermostats','Condensate'],'Plumbing':['PEX pipes & fittings','Copper pipes & fittings','ABS & PVC drainage','Valves','Supply hoses','Fixtures & toilets','Water heaters','Pumps'],'Electrical':['Wire & cable','Conduit & connectors','Breakers & panels','Boxes & covers','Switches & receptacles','Lighting'],'Construction':['Fasteners & anchors','Drywall & insulation','Lumber & framing','Adhesives & sealants','Finishing'],'Other':['Tools & equipment','Safety & PPE','Consumables','Miscellaneous']};
